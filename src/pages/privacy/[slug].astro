---
import { getCollection, type CollectionEntry } from 'astro:content';
import DocumentLayout from '../../layouts/DocumentLayout.astro';

export async function getStaticPaths() {
  return (await getCollection('apps')).map((app) => ({ params: { slug: app.data.slug }, props: { app } }));
}
interface Props { app: CollectionEntry<'apps'> }
const { app } = Astro.props;
const policy = app.data.privacy;
---

<DocumentLayout app={app} eyebrow="Informations légales" title="Politique de confidentialité" description={policy.summary} updated={policy.lastUpdated} placeholder={policy.isPlaceholder}>
  {policy.sections.map((section) => <section><h2>{section.heading}</h2><p>{section.content}</p></section>)}
</DocumentLayout>
