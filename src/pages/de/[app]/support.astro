---
import Support from '../../../views/Support.astro';
import { visibleApps } from '../../../data/apps';
import type { AppData } from '../../../data/types';

export function getStaticPaths() {
  return visibleApps.map((app) => ({ params: { app: app.slug }, props: { app } }));
}

interface Props {
  app: AppData;
}

const { app } = Astro.props;
---

<Support app={app} lang="de" />
