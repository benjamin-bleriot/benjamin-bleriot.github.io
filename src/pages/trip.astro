---
/*
 * Page privée : planisphère des endroits où je suis allé.
 * Volontairement absente de la navigation, du plan du site et des moteurs de recherche.
 * Ajouter un endroit : src/data/places.ts
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/nunito';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { loadWorld, type TripData } from '../lib/world';

const world = loadWorld();
const { stats } = world;
const data: TripData = {
  width: world.width,
  height: world.height,
  places: world.places,
  countries: Object.fromEntries(world.visited.map(({ code, name, flag, color, focus }) => [code, { name, flag, color, focus }])),
};
const json = JSON.stringify(data).replace(/</g, '\\u003c');
const plural = (n: number, word: string) => (n > 1 ? `${word}s` : word);
let lit = 0;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Mes voyages</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050507" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="trip-page">
    <div class="layout">
      <div class="map intro" id="map">
        <div class="aurora" aria-hidden="true">
          <span style="background: var(--aurora-1); top: -20vmax; left: 6%"></span>
          <span style="background: var(--aurora-2); top: -14vmax; right: -14vmax"></span>
          <span style="background: var(--aurora-3); bottom: -30vmax; left: 34%"></span>
        </div>

        <svg class="world" id="world" role="img" aria-label="Planisphère des endroits visités">
          <defs>
            <radialGradient id="ocean" cx="50%" cy="42%" r="62%">
              <stop offset="0" stop-color="#15161f" />
              <stop offset="1" stop-color="#0a0a10" />
            </radialGradient>
            <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur id="glow-blur" in="SourceGraphic" stdDeviation="3" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>
          <g id="viewport">
            <path class="sphere" d={world.sphere} />
            <path class="graticule" d={world.graticule} />
            <g class="countries">
              {
                world.countries.map((country) => (
                  <path
                    d={country.d}
                    data-code={country.code}
                    data-name={country.name}
                    class={country.color ? 'visited' : undefined}
                    style={country.color ? `--c:${country.color};--n:${lit++}` : undefined}
                  />
                ))
              }
            </g>
            <path class="sphere-edge" d={world.sphere} />
          </g>
        </svg>

        <div class="pins" id="pins"></div>
        <div class="tip" id="tip" hidden></div>
      </div>

      <div class="controls glass" role="group" aria-label="Zoom">
        <button id="zoom-in" title="Zoomer" aria-label="Zoomer"><Icon name="plus" size={18} /></button>
        <button id="zoom-out" title="Dézoomer" aria-label="Dézoomer"><Icon name="minus" size={18} /></button>
        <button id="zoom-reset" title="Le monde entier" aria-label="Voir le monde entier"><Icon name="globe" size={18} /></button>
      </div>

      <aside class="panel glass" id="panel">
        <header>
          <p class="eyebrow-s">Carnet de voyage</p>
          <h1>Mes voyages</h1>
        </header>

        <dl class="totals">
          <div><dt>pays</dt><dd>{stats.countries}</dd></div>
          <div><dt>{plural(stats.places, 'ville')}</dt><dd>{stats.places}</dd></div>
          <div><dt>{plural(stats.continents, 'continent')}</dt><dd>{stats.continents}</dd></div>
        </dl>

        <ol class="list" id="list" role="list">
          {
            world.visited.map((country) => (
              <li class="country" data-code={country.code} style={`--c:${country.color}`}>
                <button class="country-head" data-country={country.code}>
                  <span class="flag" aria-hidden="true">{country.flag}</span>
                  <strong>{country.name}</strong>
                  <span class="count">
                    {country.places.length} {plural(country.places.length, 'ville')}
                  </span>
                </button>
                <ul class="cities" role="list">
                  {country.places.map((i) => (
                    <li>
                      <button class="city" data-place={i}>{world.places[i]!.name}</button>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>

    <script type="application/json" id="trip-data" set:html={json} />
    <script>
      import '../scripts/trip';
    </script>
  </body>
</html>

<style is:global>
  .trip-page {
    --land: #262630;
    --aurora-opacity: 0.3;
    overflow: hidden;
    font-size: 15px;
  }

  .trip-page .layout {
    position: relative;
    height: 100dvh;
  }

  /* ------------------------------------------------------------ Carte */

  .trip-page .map {
    position: absolute;
    inset: 0;
    overflow: hidden;
    isolation: isolate;
    background: var(--bg);
    cursor: grab;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
  }

  .trip-page .map:active {
    cursor: grabbing;
  }

  .trip-page .map .aurora span {
    width: 48vmax;
    height: 48vmax;
    filter: blur(100px);
  }

  .trip-page .world {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }

  .trip-page .ready .world {
    opacity: 1;
  }

  .trip-page .sphere {
    fill: url(#ocean);
    fill-opacity: 0.9;
  }

  .trip-page .sphere-edge,
  .trip-page .graticule {
    fill: none;
    vector-effect: non-scaling-stroke;
    pointer-events: none;
  }

  .trip-page .sphere-edge {
    stroke: rgb(255 255 255 / 0.14);
    stroke-width: 1;
  }

  .trip-page .graticule {
    stroke: rgb(255 255 255 / 0.05);
    stroke-width: 0.6;
  }

  .trip-page .countries path {
    fill: var(--land);
    stroke: rgb(255 255 255 / 0.09);
    stroke-width: 0.6;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    transition:
      fill 0.25s,
      stroke 0.25s;
  }

  .trip-page .countries .visited {
    fill: color-mix(in srgb, var(--c) var(--tint, 50%), var(--land));
    stroke: color-mix(in srgb, var(--c) 85%, #fff);
    stroke-width: 0.9;
    cursor: pointer;
  }

  .trip-page .countries .visited.hover {
    fill: color-mix(in srgb, var(--c) calc(var(--tint, 50%) + 12%), var(--land));
  }

  .trip-page .countries .visited.active {
    fill: color-mix(in srgb, var(--c) calc(var(--tint, 50%) + 8%), var(--land));
    stroke: color-mix(in srgb, var(--c) 30%, #fff);
  }

  /* Vus de loin, les pays visités rayonnent un peu. */
  .trip-page .far .visited {
    filter: url(#glow);
  }

  @media (hover: hover) {
    .trip-page .countries path:hover {
      fill: #31313d;
    }

    .trip-page .countries .visited:hover {
      fill: color-mix(in srgb, var(--c) calc(var(--tint, 50%) + 12%), var(--land));
    }
  }

  /* ------------------------------------------------------------ Épingles */

  .trip-page .pins {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .trip-page :is(.pin, .cluster) {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    pointer-events: auto;
    will-change: transform;
  }

  .trip-page :is(.pin, .cluster)[hidden] {
    display: none;
  }

  .trip-page :is(.pin, .cluster):is(:hover, .hover, .selected) {
    z-index: 2;
  }

  .trip-page .pin .dot {
    position: absolute;
    left: -6px;
    top: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 3px var(--c),
      0 0 18px 4px color-mix(in srgb, var(--c) 70%, transparent),
      0 3px 8px rgb(0 0 0 / 0.6);
    transition: transform 0.25s var(--ease);
  }

  .trip-page .pin .dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border: 2px solid var(--c);
    border-radius: 50%;
    opacity: 0;
  }

  .trip-page .pin:is(:hover, .hover) .dot {
    transform: scale(1.25);
  }

  .trip-page .pin.selected .dot {
    transform: scale(1.4);
  }

  .trip-page .cluster .bubble {
    position: absolute;
    left: -13px;
    top: -13px;
    width: 26px;
    height: 26px;
    padding: 2.5px;
    border-radius: 50%;
    background: var(--ring);
    box-shadow:
      0 0 22px 2px color-mix(in srgb, var(--c) 55%, transparent),
      0 4px 12px rgb(0 0 0 / 0.6);
    transition: transform 0.25s var(--ease);
  }

  .trip-page .cluster .count {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #111117;
    color: #fff;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .trip-page .cluster:is(:hover, .hover, .selected) .bubble {
    transform: scale(1.12);
  }

  .trip-page :is(.pin, .cluster) .label {
    position: absolute;
    top: 0;
    left: 15px;
    padding: 3px 9px;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 999px;
    background: rgb(14 14 20 / 0.86);
    box-shadow: 0 8px 20px -10px rgb(0 0 0 / 0.9);
    color: var(--text);
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.35;
    white-space: nowrap;
    transform: translateY(-50%);
    transition: opacity 0.2s;
  }

  .trip-page .cluster .label {
    left: 19px;
  }

  .trip-page :is(.pin, .cluster).left .label {
    left: auto;
    right: 15px;
  }

  .trip-page .cluster.left .label {
    right: 19px;
  }

  .trip-page :is(.pin, .cluster).below .label {
    top: 14px;
    left: 0;
    transform: translateX(-50%);
  }

  .trip-page .cluster.below .label {
    top: 17px;
  }

  .trip-page :is(.pin, .cluster).no-label .label {
    opacity: 0;
    pointer-events: none;
  }

  .trip-page :is(.pin, .cluster):is(:hover, .hover, .selected) .label {
    opacity: 1;
  }

  .trip-page .pin.selected .label {
    border-color: transparent;
    background: var(--ink);
    color: var(--ink-text);
  }

  .trip-page .label:empty {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .trip-page .pin .dot,
    .trip-page .cluster .bubble {
      animation: pop 0.45s var(--ease) backwards;
    }

    .trip-page .intro :is(.pin .dot, .cluster .bubble) {
      animation-delay: calc(var(--i, 0) * 90ms + 700ms);
    }

    .trip-page .pin .dot::after {
      animation: ripple 2.8s var(--ease) infinite;
      animation-delay: calc(var(--i, 0) * -0.45s);
    }

    .trip-page .intro .visited {
      animation: light-up 1.4s var(--ease) backwards;
      animation-delay: calc(var(--n, 0) * 160ms + 450ms);
    }
  }

  @keyframes pop {
    from {
      transform: scale(0);
    }
  }

  @keyframes ripple {
    0% {
      transform: scale(1);
      opacity: 0.85;
    }
    70%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }

  @keyframes light-up {
    from {
      fill: var(--land);
      stroke: rgb(255 255 255 / 0.09);
    }
  }

  /* Nom du pays survolé */
  .trip-page .tip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 11px;
    border: 1px solid var(--glass-line);
    border-radius: 12px;
    background: rgb(18 18 24 / 0.92);
    box-shadow: var(--shadow-sm);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
  }

  .trip-page .tip[hidden] {
    display: none;
  }

  .trip-page .tip small {
    color: var(--text-3);
    font-size: 12px;
    font-weight: 500;
  }

  /* ------------------------------------------------------------ Zoom */

  .trip-page .controls {
    position: absolute;
    z-index: 500;
    top: 16px;
    right: 16px;
    display: grid;
    gap: 2px;
    padding: 4px;
    border-radius: 16px;
  }

  .trip-page .controls button {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 12px;
    background: none;
    color: var(--text-2);
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .trip-page .controls button:hover {
    background: rgb(255 255 255 / 0.1);
    color: var(--text);
  }

  /* ------------------------------------------------------------ Panneau */

  .trip-page .panel {
    position: absolute;
    z-index: 500;
    top: 16px;
    left: 16px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 360px;
    max-height: calc(100dvh - 32px);
    padding: 22px 20px 20px;
    border-radius: var(--radius-m);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Quand la liste déborde, c'est le panneau qui défile : aucun bloc ne doit rétrécir. */
  .trip-page .panel > * {
    flex: none;
  }

  .trip-page .eyebrow-s {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .trip-page h1 {
    margin-top: 2px;
    font-size: 32px;
  }

  .trip-page .totals {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin: 0;
    border-radius: var(--radius-s);
    overflow: hidden;
    background: var(--line);
  }

  .trip-page .totals div {
    display: flex;
    flex-direction: column-reverse;
    padding: 10px 6px;
    background: rgb(12 12 16 / 0.6);
    text-align: center;
  }

  .trip-page .totals dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .trip-page .totals dd small {
    margin-left: 1px;
    font-size: 13px;
    color: var(--text-3);
  }

  .trip-page .totals dt {
    font-size: 11.5px;
    color: var(--text-3);
  }

  .trip-page .list {
    display: grid;
    gap: 8px;
  }

  .trip-page .country {
    padding: 4px 4px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    background: var(--card);
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .trip-page .country:is(.hover, .active) {
    border-color: color-mix(in srgb, var(--c) 45%, transparent);
    background: color-mix(in srgb, var(--c) 8%, var(--card));
  }

  .trip-page .country-head {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 8px 8px 8px 10px;
    border: 0;
    border-radius: 10px;
    background: none;
    text-align: left;
    cursor: pointer;
  }

  .trip-page .flag {
    font-size: 22px;
    line-height: 1;
  }

  .trip-page .country-head strong {
    flex: 1;
    min-width: 0;
    font-size: 16px;
    letter-spacing: -0.01em;
  }

  .trip-page .country-head .count {
    font-size: 12.5px;
    color: var(--text-3);
    white-space: nowrap;
  }

  .trip-page .cities {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0 10px;
  }

  .trip-page .city {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px 5px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(0 0 0 / 0.2);
    color: var(--text-2);
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .trip-page .city::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 8px var(--c);
  }

  .trip-page .city:is(:hover, .hover) {
    border-color: var(--line-strong);
    color: var(--text);
  }

  .trip-page .city.active {
    border-color: transparent;
    background: var(--ink);
    color: var(--ink-text);
  }

  /* ------------------------------------------------------------ Mobile */

  @media (max-width: 760px) {
    .trip-page {
      overflow: auto;
    }

    .trip-page .layout {
      display: flex;
      flex-direction: column;
      height: auto;
    }

    .trip-page .map {
      position: relative;
      inset: auto;
      flex: none;
      height: min(64dvh, calc(52vw + 200px));
    }

    .trip-page .controls {
      top: 12px;
      right: 12px;
      grid-auto-flow: column;
    }

    .trip-page .panel {
      position: relative;
      inset: auto;
      width: auto;
      max-height: none;
      margin: -28px 12px 12px;
      overflow: visible;
    }
  }
</style>
