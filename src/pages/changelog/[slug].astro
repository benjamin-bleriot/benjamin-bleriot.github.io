---
import { getCollection, type CollectionEntry } from 'astro:content';
import DocumentLayout from '../../layouts/DocumentLayout.astro';
import AppChangelog from '../../components/AppChangelog.astro';

export async function getStaticPaths() {
  return (await getCollection('apps')).map((app) => ({ params: { slug: app.data.slug }, props: { app } }));
}
interface Props { app: CollectionEntry<'apps'> }
const { app } = Astro.props;
---

<DocumentLayout app={app} eyebrow="Notes de version" title="Historique des versions" description={`Mises à jour et notes de version de ${app.data.name}.`}>
  <AppChangelog entries={app.data.changelog} />
</DocumentLayout>
