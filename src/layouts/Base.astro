---
import '@fontsource-variable/inter';
import '@fontsource-variable/nunito';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import type { AppData, Lang } from '../data/types';
import { htmlLang, LANGS, localizePath, otherLangs, useTranslations } from '../i18n';
import { themeStyle } from '../lib/apps';

interface Props {
  lang: Lang;
  /** Chemin de la page sans préfixe de langue, ex. '/jogr/privacy/'. */
  path: string;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  largeImage?: boolean;
  app?: AppData;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { lang, path, title, description, image, imageAlt, largeImage = true, app, jsonLd, noindex } = Astro.props;
const t = useTranslations(lang);
const siteUrl = Astro.site ?? new URL('https://benjamin-bleriot.github.io');
const url = (target: string) => new URL(target, siteUrl).href;
const canonical = url(localizePath(path, lang));
const alternate = (code: Lang) => url(localizePath(path, code));
const ogImage = url(image ?? (lang === 'fr' ? '/og.png' : `/og-${lang}.png`));
---

<!doctype html>
<html lang={htmlLang(lang)} style={app ? themeStyle(app) : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {LANGS.map((code) => <link rel="alternate" hreflang={code} href={alternate(code)} />)}
    <link rel="alternate" hreflang="x-default" href={alternate('fr')} />

    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050507" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {app?.appStoreId && <meta name="apple-itunes-app" content={`app-id=${app.appStoreId}`} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.author} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:locale" content={t('meta.locale')} />
    {otherLangs(lang).map((code) => <meta property="og:locale:alternate" content={useTranslations(code)('meta.locale')} />)}
    <meta name="twitter:card" content={largeImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Nav lang={lang} path={path} app={app} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} path={path} />
  </body>
</html>
