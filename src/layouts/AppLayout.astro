---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import AppHero from '../components/AppHero.astro';
import AppScreenshots from '../components/AppScreenshots.astro';
import AppFeatures from '../components/AppFeatures.astro';
import AppReviews from '../components/AppReviews.astro';
import AppFAQ from '../components/AppFAQ.astro';
import AppStoreButton from '../components/AppStoreButton.astro';
import { getAppIcon, getAppScreenshots } from '../lib/apps';

interface Props { app: CollectionEntry<'apps'> }
const { app } = Astro.props;
const { Content } = await render(app);
const screenshots = getAppScreenshots(app);
const icon = getAppIcon(app);
const canonicalPath = `/apps/${app.data.slug}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.data.name,
  description: app.data.description,
  operatingSystem: 'iOS',
  applicationCategory: app.data.category,
  url: new URL(canonicalPath, Astro.site ?? Astro.url.origin).toString(),
  ...(app.data.appStoreUrl ? { installUrl: app.data.appStoreUrl } : {}),
};
---

<BaseLayout title={`${app.data.name} — Benjamin Bleriot`} description={app.data.description} canonicalPath={canonicalPath} image={icon} jsonLd={jsonLd}>
  <AppHero app={app} />
  <AppScreenshots screenshots={screenshots} appName={app.data.name} />
  <AppFeatures features={app.data.features} />
  <section class="section app-story" aria-labelledby="story-title">
    <div class="container story-grid">
      <div><p class="eyebrow">À propos</p><h2 id="story-title">Pensée pour l’iPhone.</h2></div>
      <div class="prose"><Content />{app.data.technologies.length > 0 && <ul class="technology-list" aria-label="Technologies">{app.data.technologies.map((technology) => <li>{technology}</li>)}</ul>}</div>
    </div>
  </section>
  <AppReviews reviews={app.data.reviews} />
  <AppFAQ faq={app.data.faq} />
  <section class="section final-cta" style={`--app-accent: ${app.data.accent}`}>
    <div class="container final-cta-inner"><p class="eyebrow">{app.data.name}</p><h2>{app.data.appStoreUrl ? 'Prête pour votre prochaine partie.' : 'Suivez l’évolution de l’application.'}</h2><p>{app.data.shortDescription}</p><AppStoreButton url={app.data.appStoreUrl} /></div>
  </section>
  <nav class="container app-subnav" aria-label={`Informations sur ${app.data.name}`}>
    <a href={`/privacy/${app.data.slug}/`}>Confidentialité</a><a href={`/terms/${app.data.slug}/`}>Conditions</a><a href={`/changelog/${app.data.slug}/`}>Versions</a>
  </nav>
</BaseLayout>
