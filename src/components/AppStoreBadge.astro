---
import type { Lang } from '../data/types';

interface Props {
  href: string;
  lang: Lang;
  height?: number;
}

const { href, lang, height = 52 } = Astro.props;
// Badges officiels d'Apple, téléchargés par `npm run appstore:images`.
const badges: Record<Lang, { ratio: number; alt: string }> = {
  fr: { ratio: 126.50751 / 40, alt: 'Télécharger dans l’App Store' },
  en: { ratio: 119.66407 / 40, alt: 'Download on the App Store' },
  de: { ratio: 119.66407 / 40, alt: 'Laden im App Store' },
};
const { ratio, alt } = badges[lang];
---

<a class="badge" href={href} target="_blank" rel="noopener">
  <img src={`/appstore/badge-${lang}.svg`} alt={alt} width={Math.round(height * ratio)} height={height} />
</a>

<style>
  .badge {
    display: inline-block;
    border-radius: 12px;
    transition: transform 0.25s var(--ease);
  }

  .badge:hover {
    transform: translateY(-2px);
  }

  .badge img {
    height: auto;
  }
</style>
