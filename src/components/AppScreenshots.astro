---
import type { Screenshot } from '../lib/apps';
interface Props { screenshots: Screenshot[]; appName: string }
const { screenshots, appName } = Astro.props;
---

<section class="section screenshots-section" id="screenshots" aria-labelledby="screenshots-title">
  <div class="container">
    <div class="section-heading"><p class="eyebrow">Preview</p><h2 id="screenshots-title">See {appName} in action.</h2></div>
    {screenshots.length > 0 ? (
      <div class="screenshot-strip">
        {screenshots.map((screenshot) => (
          <figure><img src={screenshot.image} alt={screenshot.alt} loading="lazy" decoding="async" />{screenshot.caption && <figcaption>{screenshot.caption}</figcaption>}</figure>
        ))}
      </div>
    ) : (
      <div class="empty-screenshots">
        <div class="empty-grid" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div><h3>Screenshots are on their way.</h3><p>Real product images will be added here when they are ready. No mock interface is being shown in their place.</p></div>
      </div>
    )}
  </div>
</section>
