---
interface Props {
  url?: string;
  compact?: boolean;
}

const { url = '', compact = false } = Astro.props;
---

{url ? (
  <a class:list={['store-button', { compact }]} href={url} rel="noreferrer" aria-label="Download on the App Store">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.1 12.5c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.2-2-3.8-2-1.6-.2-3.2 1-4 .9-.9 0-2.1-.9-3.5-.9-1.8 0-3.5 1.1-4.5 2.7-1.9 3.3-.5 8.2 1.4 10.9.9 1.3 2 2.8 3.5 2.7 1.4-.1 1.9-.9 3.6-.9s2.2.9 3.7.9 2.5-1.3 3.4-2.7c1.1-1.5 1.5-3 1.5-3.1-.1 0-3.5-1.3-3.5-4.6ZM14.4 4.9c.8-1 1.3-2.3 1.2-3.6-1.1.1-2.5.8-3.3 1.7-.7.8-1.4 2.2-1.2 3.4 1.3.1 2.5-.6 3.3-1.5Z"/></svg>
    <span><small>Download on the</small>App Store</span>
  </a>
) : import.meta.env.DEV ? (
  <span class="store-placeholder" title="Add appStoreUrl in the app content file">App Store link pending</span>
) : null}
