---
import AppIcon from './AppIcon.astro';
import Icon from './Icon.astro';
import type { AppData, Lang } from '../data/types';
import { formatRating, localizePath, useTranslations } from '../i18n';
import { pickShots, rating, themeStyle } from '../lib/apps';

interface Props {
  app: AppData;
  lang: Lang;
}

const { app, lang } = Astro.props;
const t = useTranslations(lang);
const [front, back] = pickShots(app, lang, app.shots?.card);
const score = rating(app);
---

<a class="app-card grain reveal" href={localizePath(`/${app.slug}/`, lang)} style={themeStyle(app)}>
  <div class="text">
    <p class="eyebrow">{app.eyebrow[lang]}</p>
    <h3 set:html={app.headline[lang]} />
  </div>

  <div class="shots" aria-hidden="true">
    {back && <img class="shot back" src={back} alt="" width="600" height="1304" loading="lazy" decoding="async" />}
    {front && <img class="shot front" src={front} alt="" width="600" height="1304" loading="lazy" decoding="async" />}
  </div>

  <div class="bar">
    <AppIcon app={app} size={54} />
    <div class="meta">
      <strong>{app.name}</strong>
      <span>{app.tagline[lang]}</span>
    </div>
    {
      score && score.count > 0 && (
        <span class="score" title={t('app.ratings', { n: score.count })}>
          <Icon name="star" size={14} />
          {formatRating(score.average, lang)}
        </span>
      )
    }
    <span class="go">
      <span class="go-label">{t('home.discover')}</span>
      <Icon name="arrow-right" size={17} />
    </span>
  </div>
</a>

<style>
  .app-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 560px;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-xl);
    color: #fff;
    background:
      radial-gradient(90% 60% at 15% 0%, color-mix(in srgb, var(--grad-a) 70%, #fff) 0%, transparent 60%),
      radial-gradient(70% 55% at 100% 100%, color-mix(in srgb, var(--glow) 55%, transparent), transparent 70%),
      linear-gradient(165deg, var(--grad-a), var(--grad-b));
    box-shadow: var(--shadow-md);
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  .app-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .text {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 12px;
    padding: clamp(26px, 4vw, 38px) clamp(26px, 4vw, 38px) 0;
  }

  .eyebrow {
    color: rgb(255 255 255 / 0.78);
  }

  h3 {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-shadow: 0 2px 20px rgb(0 0 0 / 0.12);
  }

  .shots {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .shot {
    position: absolute;
    width: min(46%, 250px);
    border-radius: 24px;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.18),
      0 30px 60px -20px rgb(0 0 0 / 0.55);
    transition: transform 0.7s var(--ease);
  }

  .front {
    right: 9%;
    top: 196px;
    transform: rotate(5deg);
  }

  .back {
    right: 40%;
    top: 236px;
    transform: rotate(-7deg) scale(0.92);
    filter: saturate(0.9) brightness(0.92);
  }

  .app-card:hover .front {
    transform: rotate(3deg) translateY(-18px);
  }

  .app-card:hover .back {
    transform: rotate(-9deg) scale(0.92) translateY(-8px);
  }

  .bar {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 14px;
    margin: auto 14px 14px;
    padding: 12px 12px 12px 12px;
    border-radius: 26px;
    background: color-mix(in srgb, var(--grad-b) 58%, rgb(0 0 0 / 0.12));
    border: 1px solid rgb(255 255 255 / 0.24);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.3),
      0 16px 40px -18px rgb(0 0 0 / 0.55);
    -webkit-backdrop-filter: blur(26px) saturate(160%);
    backdrop-filter: blur(26px) saturate(160%);
  }

  .bar :global(.app-icon) {
    flex: none;
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.15),
      0 8px 18px -8px rgb(0 0 0 / 0.5);
  }

  .meta {
    display: grid;
    min-width: 0;
    line-height: 1.25;
  }

  .meta strong {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .meta span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 14px;
    color: rgb(255 255 255 / 0.82);
  }

  .score {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    font-size: 14px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .score :global(.icon) {
    fill: currentColor;
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font-size: 15px;
    font-weight: 700;
  }

  .go :global(.icon) {
    transition: transform 0.3s var(--ease);
  }

  .app-card:hover .go :global(.icon) {
    transform: translateX(3px);
  }

  .meta + .go {
    margin-left: auto;
  }

  @media (max-width: 520px) {
    .app-card {
      min-height: 520px;
    }

    .go-label,
    .score {
      display: none;
    }

    .go {
      width: 40px;
      padding: 0;
      justify-content: center;
      margin-left: auto;
    }

    .front {
      top: 168px;
      right: 6%;
      width: 50%;
    }

    .back {
      top: 204px;
      right: 42%;
      width: 44%;
    }
  }
</style>
