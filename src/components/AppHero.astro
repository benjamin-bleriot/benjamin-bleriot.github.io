---
import type { CollectionEntry } from 'astro:content';
import AppIcon from './AppIcon.astro';
import AppStoreButton from './AppStoreButton.astro';
import { getAppIcon } from '../lib/apps';

interface Props { app: CollectionEntry<'apps'> }
const { app } = Astro.props;
const icon = getAppIcon(app);
const initials = app.data.name.split(/\s+/).map((word) => word[0]).join('').slice(0, 2);
const statusLabel = app.data.status === 'available' ? 'Disponible sur l’App Store' : app.data.status === 'coming-soon' ? 'Bientôt disponible' : 'En développement';
---

<section class="app-hero section" style={`--app-accent: ${app.data.accent}`}>
  <div class="container app-hero-grid">
    <div class="app-hero-copy">
      <div class="app-identity">
        <AppIcon name={app.data.name} icon={icon} accent={app.data.accent} size="large" />
        <div><p class="eyebrow">{app.data.category}</p><p>{statusLabel}</p></div>
      </div>
      <h1>{app.data.hero.title}</h1>
      <p class="lede">{app.data.hero.subtitle}</p>
      <div class="hero-actions">
        <AppStoreButton url={app.data.appStoreUrl} />
        <a class="button button-secondary" href="#features">Voir les fonctionnalités</a>
      </div>
    </div>
    <div class="app-hero-art" aria-hidden="true">
      <div class="hero-mark">{icon ? <img src={icon} alt="" width="320" height="320" /> : <span>{initials}</span>}</div>
      <small>Icône officielle de l’application</small>
    </div>
  </div>
</section>
