---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/apps';
interface Props { entries: CollectionEntry<'apps'>['data']['changelog'] }
const { entries } = Astro.props;
---

<div class="changelog-list">
  {entries.length > 0 ? entries.map((entry) => <article class="release-entry">
    <header><div><p class="eyebrow">Version</p><h2>{entry.version}</h2></div><p>{entry.date ? formatDate(entry.date) : entry.label ?? 'Date to be confirmed'}</p></header>
    {entry.additions.length > 0 && <section><h3>What’s new</h3><ul>{entry.additions.map((item) => <li>{item}</li>)}</ul></section>}
    {entry.fixes.length > 0 && <section><h3>Fixes</h3><ul>{entry.fixes.map((item) => <li>{item}</li>)}</ul></section>}
  </article>) : <p>No release notes have been published yet.</p>}
</div>
