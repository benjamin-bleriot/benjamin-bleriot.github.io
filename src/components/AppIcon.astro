---
import type { AppData } from '../data/types';
import { iconUrl } from '../lib/apps';

interface Props {
  app: AppData;
  size: number;
  class?: string;
  eager?: boolean;
}

const { app, size, class: className, eager = false } = Astro.props;
---

<img
  class:list={['app-icon', className]}
  src={iconUrl(app)}
  alt={`${app.name}`}
  width={size}
  height={size}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  style={`width:${size}px;height:${size}px`}
/>
